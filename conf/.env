# 项目默认环境变量示例（非敏感配置说明）
# 生产环境请在运行前替换为真实值，切勿提交真实密钥到版本库。

SERVER__HOST=0.0.0.0
SERVER__PORT=8082

# 服务器 mysql_hugegraph 实例（端口 8306）
# DATABASE__URL=mysql+pymysql://root:bdtt67FS#q@127.0.0.1:8306/llm_construct?charset=utf8mb4
# 本地 Docker mysql 实例（端口 3306）
DATABASE__URL=mysql+pymysql://root:root@127.0.0.1:3306/llm_construct?charset=utf8mb4

# 服务器 redis 实例，无密码
# REDIS__HOST=127.0.0.1
# REDIS__PORT=8369
# REDIS__DB=10
# 本地 Docker redis 实例，无密码
REDIS__HOST=127.0.0.1
REDIS__PORT=6379
REDIS__DB=0
REDIS__QUEUE_NAME=edu_construct_parse_queue

# 服务器 minio-oss 实例（API 端口 8999）
# OSS__ENDPOINT=http://127.0.0.1:8999
# 本地 Docker minio 实例（API 端口 9000）
OSS__ENDPOINT=http://127.0.0.1:9000
OSS__ACCESS_KEY=minioadmin
OSS__SECRET_KEY=minioadmin
OSS__BUCKET_NAME=llm-construct

# OCR：默认使用 PaddleOCR 云 API（异步 /api/v2/ocr/jobs 端点）
OCR__PROVIDER=paddle-cloud
# 同步 /layout-parsing 端点（当前未使用）
OCR__PADDLE_CLOUD__BASE_URL=
OCR__PADDLE_CLOUD__API_KEY=
# 异步 /api/v2/ocr/jobs 端点
OCR__PADDLE_CLOUD__JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
OCR__PADDLE_CLOUD__TOKEN=8d05162c96c502c34676179f6b2075d4b8bedfc1
OCR__PADDLE_CLOUD__MODEL=PaddleOCR-VL-1.6
# 对应 PaddleOCR 云 API optionalPayload 中的功能开关
OCR__PADDLE_CLOUD__USE_DOC_ORIENTATION_CLASSIFY=False
OCR__PADDLE_CLOUD__USE_DOC_UNWARPING=False
OCR__PADDLE_CLOUD__USE_CHART_RECOGNITION=False

# 本地 VL 服务（与 paddle-cloud 二选一）
# 当前 paddleocr-vlm-server 容器未映射宿主机端口，
# 需要把主服务加入同一 Docker 网络，或给容器加 -p 8080:8080 映射后才能使用。
# OCR__PROVIDER=paddle-vl-local
# OCR__PADDLE_VL_LOCAL__SERVER_URL=http://paddleocr-vlm-server:8080/v1
# OCR__PADDLE_VL_LOCAL__DEVICE=gpu:0

FFMPEG__PATH=ffmpeg
FFMPEG__FRAME_RATE=1
FFMPEG__OUTPUT_FORMAT=jpg
FFMPEG__QUALITY=2

VIDEO__DEDUP_MODE=scene
VIDEO__SCENE_THRESHOLD=0.05
