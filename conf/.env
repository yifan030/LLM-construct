# 项目默认环境变量示例（非敏感配置说明）
# 生产环境请在运行前替换为真实值，切勿提交真实密钥到版本库。

# SERVER_HOST=0.0.0.0
# SERVER_PORT=8000

# DATABASE_URL=mysql+pymysql://root:root@localhost:3306/llm_construct?charset=utf8mb4

# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_QUEUE_NAME=edu_construct_parse_queue

# OSS_ENDPOINT=http://localhost:9000
# OSS_ACCESS_KEY=minioadmin
# OSS_SECRET_KEY=minioadmin
# OSS_BUCKET_NAME=llm-construct

# OCR_PROVIDER=paddle-cloud
# OCR_PADDLE_CLOUD__BASE_URL=
# OCR_PADDLE_CLOUD__API_KEY=
# OCR_PADDLE_CLOUD__JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
# OCR_PADDLE_CLOUD__TOKEN=
# OCR_PADDLE_CLOUD__MODEL=PaddleOCR-VL-1.6
# OCR_PADDLE_VL_LOCAL__SERVER_URL=
# OCR_PADDLE_VL_LOCAL__DEVICE=gpu:0

# FFMPEG_PATH=ffmpeg
# FFMPEG_FRAME_RATE=1
# FFMPEG_OUTPUT_FORMAT=jpg
# FFMPEG_QUALITY=2

# VIDEO_DEDUP_MODE=scene
# VIDEO_SCENE_THRESHOLD=0.05
